<Window x:Class="MogoPrint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="모고 프린트" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="14"
        AllowDrop="True" Icon="icon256.png" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

        <!-- 처음 화면: 끌어다 놓기 -->
        <Grid x:Name="DropZone">
            <Rectangle x:Name="DropFrame" Margin="28" RadiusX="18" RadiusY="18" StrokeThickness="2"
                       StrokeDashArray="4.5 3" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.55" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DropIcon" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="60"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="모의고사 PDF를 여기에 끌어다 놓으세요" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Text="여러 파일이나 폴더도 한 번에 돼요. 프로그램 아이콘에 놓아도 열려요." Style="{StaticResource Secondary}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="파일 선택…" Padding="16,7" Margin="0,0,12,0" Click="Open_Click" />
                    <Button Content="평가원에서 받기…" Padding="16,7" Click="Kice_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 본 화면 -->
        <Grid x:Name="MainArea" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 파일 목록과 설정 -->
            <Grid Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="파일 · 끌어서 순서 변경" Style="{StaticResource SectionHeader}" />
                <ListBox x:Name="FileList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="4,0"
                         AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="FileList_PreviewMouseMove"
                         DragOver="FileList_DragOver" Drop="FileList_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,2,9,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Background="#33FF9500"
                                                Visibility="{Binding IsCombined, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="홀·짝 합본" FontSize="11.5" Style="{StaticResource Secondary}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="#2E34C759"
                                                Visibility="{Binding HasElective, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding ElectiveText}" FontSize="11.5" Style="{StaticResource Secondary}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="#2E0A84FF"
                                                Visibility="{Binding Adjusted, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="손봄" FontSize="11.5" Style="{StaticResource Secondary}" />
                                        </Border>
                                        <TextBlock Text="+빈 쪽" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding PadsBlank, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7A8;" ToolTip="여백 조정"
                                        Foreground="{Binding CropBrush}" Click="FileCrop_Click" VerticalAlignment="Top" />
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="목록에서 빼기"
                                        Click="FileRemove_Click" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="LoadingRow" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,8" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="40" Height="4" VerticalAlignment="Center" />
                    <TextBlock Text="불러오는 중…" Style="{StaticResource Secondary}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- 설정 -->
                <Border Grid.Row="2" Margin="12,8,12,0" CornerRadius="8" BorderThickness="1" Padding="0,4"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel x:Name="SettingsPanel" />
                </Border>

                <Grid Grid.Row="3" Margin="12">
                    <Button x:Name="SaveButton" Content="PDF로 저장…" HorizontalAlignment="Left" Padding="12,6" Click="Save_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ProgressBar x:Name="PrintingBar" IsIndeterminate="True" Width="40" Height="4" Margin="0,0,10,0" Visibility="Collapsed" />
                        <Button x:Name="PrintButton" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Click="Print_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" Style="{StaticResource ToolIcon}" />
                                <TextBlock x:Name="PrintButtonText" Text="인쇄…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- 오른쪽: 미리보기 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="WorkingBar" IsIndeterminate="True" Width="40" Height="4" Margin="10,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CropButton" Click="Crop_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A8;" Style="{StaticResource ToolIcon}" /><TextBlock Text="여백 조정" /></StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Click="Kice_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource ToolIcon}" /><TextBlock Text="기출 받기" /></StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Click="Open_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource ToolIcon}" /><TextBlock Text="추가" /></StackPanel>
                        </Button>
                        <Button Content="모두 비우기" Margin="8,0,0,0" Click="Clear_Click" />
                    </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="2">
                    <Grid x:Name="PreviewGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="Thumbs" BorderThickness="0" Background="Transparent" SelectionChanged="Thumbs_SelectionChanged"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="4,6" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Loaded="Thumb_Loaded">
                                        <Border Width="78" Height="110" Background="White" BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ItemsControl x:Name="Pages" Grid.Column="1" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True"
                                      SizeChanged="Pages_SizeChanged">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Border Background="{TemplateBinding Background}">
                                        <ScrollViewer x:Name="PART_Scroll" CanContentScroll="True" Focusable="False" Padding="0,14,0,0"
                                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="{Binding Height}" Margin="0,0,0,14" Background="White"
                                            BorderThickness="1" BorderBrush="#33000000" HorizontalAlignment="Center"
                                            Loaded="Page_Loaded" Unloaded="Page_Unloaded">
                                        <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ContentControl x:Name="ManualHost" Visibility="Collapsed" />
                </Grid>

                <Rectangle Grid.Row="3" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <DockPanel Grid.Row="4" Margin="14,6" LastChildFill="False">
                    <StackPanel x:Name="StatusRow" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="13" />
                        <Button Content="닫기" Margin="8,0,0,0" Padding="6,1" FontSize="12" Click="StatusClose_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PageIndicator" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
